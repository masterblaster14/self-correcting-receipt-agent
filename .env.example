# Copy to .env and fill in. run.py / run_cli.py load this file automatically.
ANTHROPIC_API_KEY=sk-ant-...
# Vision model. claude-opus-5 (default) is most accurate; claude-sonnet-5 is ~2.5x cheaper for testing.
MODEL=claude-opus-5
# low | medium | high - reasoning effort per call (latency vs. care)
EFFORT=medium
# Set to 1 to run the whole app offline with canned model responses
MOCK_LLM=0

# Optional: email reports (PDF + Excel) to the manager / finance. Gmail: use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com

# Optional: where SQLite + receipt files live (Railway: mount a volume at /data and set this)
# DATA_DIR=/data

# Accounts. Sign-in is enabled as soon as Google OR SMTP is configured; otherwise the app is open.
ALLOWED_DOMAINS=vitstudent.ac.in          # comma-separated organisation domains allowed to sign in
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# APP_URL=https://your-host                # public base URL, used for the Google redirect URI
# ADMIN_EMAILS=om.gunjangupta2024@vitstudent.ac.in
# AUTH_DEV_CODE=1                          # dev only: print email login codes to the terminal instead of sending
# SECRET_KEY=change-me                     # cookie signing key (auto-generated into DATA_DIR if unset)
